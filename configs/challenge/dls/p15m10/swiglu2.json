{
    "data_name":        "Challenge2_1_train",

    "latent_type":      "dls",

    "latent_params": {
        "patch_size":   15,
        "num_modes":    10
    },

    "model":            "tr_enc",

    "params": {
        "time_lag":     65,
        "d_model":      256,
        "ff_dim":       768,
        "nhead":        4,
        "num_layers":   4,
        "embed":        "lin",
        "activation":   "swiglu",
        "prenorm":       true
    },

    "train": {
        "train_split":  0.8,
        "test_split":   0.1,
        "sample_train": 0,
        "sample_test":  0,
        "lr":           0.001,
        "num_epochs":   10000,
        "patience":     50,
        "train_ahead":  5,
        "batch_size":   256,
        "gamma":        1
    },

    "predictions": {
        "validation": {
            "init":     "val",
            "lim":      null
        },
        "seen": {
            "init":     "train",
            "lim":      null
        },
        "short_val": {
            "init":     "val",
            "lim":      200
        }
    }
}
